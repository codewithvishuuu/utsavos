# Copy to .env for docker compose, or to apps/api/.env when running the API on the host.
# Never commit a real secret.

APP_ENV=development
# Required by docker compose. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production rejects the development placeholder and anything under 32 characters.
APP_SECRET_KEY=

# PostgreSQL (host development). Keep the password in both places, URL-encoded.
DATABASE_URL=postgresql+psycopg://utsavos:CHANGE_ME_URL_SAFE@localhost:5432/utsavos
# Required by docker compose for the db service. Use 16+ URL-safe characters.
POSTGRES_PASSWORD=
# Production requires verified TLS on the database connection; production startup
# and /readyz fail closed without both query parameters:
# DATABASE_URL=postgresql+psycopg://utsavos:CHANGE_ME_URL_SAFE@db-host:5432/utsavos?sslmode=verify-full&sslrootcert=/etc/ssl/certs/db-ca.crt

# Cookies. Leave unset in production to force Secure + __Host- cookies.
# SESSION_COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173

# Optional trusted reverse proxies (comma-separated IPs or CIDRs). X-Forwarded-For
# is only read when the socket peer is in this list.
TRUSTED_PROXY_IPS=
# HSTS is sent only when APP_ENV=production.
HSTS_MAX_AGE_SECONDS=31536000

# Local AI (Ollama). Disabled by default in the shipped compose file.
AI_LOCAL_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Only for a trusted Ollama on a non-private network. Private notes are still
# never sent to a remote endpoint; only computed fact sheets are.
AI_LOCAL_ALLOW_REMOTE=false
AI_TIMEOUT_SECONDS=120

# Cloud AI is opt-in, requires a server-side key and per-user consent.
CLOUD_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Limits
DEMO_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# Login windows: per source IP and per normalised account email (single process).
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
MAX_REQUEST_BYTES=65536
LOG_LEVEL=INFO

# Database waits (all environments). Requests fail bounded instead of hanging.
# DB_POOL_TIMEOUT_SECONDS=5   waiting for a pooled connection
# DB_STATEMENT_TIMEOUT_MS=15000  server-side statement timeout
# DB_LOCK_TIMEOUT_MS=5000        server-side lock wait timeout

# Only for the single-image deployment; defaults to apps/web/dist next to the source.
# WEB_DIST_DIR=/app/web/dist
